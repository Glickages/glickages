---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialSidebar from '../components/SocialSidebar.astro';
import { contactLinks } from '../lib/site';

const filters = ['All', 'Business Websites', 'Nonprofit Websites', 'Blogs & CMS', 'Portfolios'];

const projects = [
  {
    id: 1,
    name: 'Love Fest Foundation',
    category: 'Nonprofit Websites',
    subCategory: 'Mission & Outreach',
    url: 'https://lff-website.lovefestfoundation.workers.dev/',
    displayUrl: 'lff-website.lovefestfoundation.workers.dev',
    oneLiner: 'Nonprofit mission and community outreach website with programmes information and get-involved paths.',
    image: '/projects/lovefest.png',
    handled: [
      'Nonprofit mission and outreach',
      'Community programmes overview',
      'Get-involved and support paths',
      'Responsive design',
    ],
    tags: ['Nonprofit Websites'],
  },
  {
    id: 2,
    name: 'ICC Studios',
    category: 'Business Websites',
    subCategory: 'Photography & Creative Services',
    url: 'https://icc-delta.vercel.app/',
    displayUrl: 'icc-delta.vercel.app',
    oneLiner: 'Photography portfolio and services website presenting studio work and direct contact routes.',
    image: '/projects/icc.png',
    handled: [
      'Photography portfolio showcase',
      'Studio services overview',
      'Contact and enquiry routes',
      'Responsive layout',
    ],
    tags: ['Business Websites', 'Portfolios'],
  },
  {
    id: 3,
    name: 'Warrior Fitness',
    category: 'Business Websites',
    subCategory: 'Fitness & Programmes',
    url: 'https://warrior-fitness-xi.vercel.app/',
    displayUrl: 'warrior-fitness-xi.vercel.app',
    oneLiner: 'Fitness business website featuring training programmes, membership information, and external signup links.',
    image: '/projects/warrior.png',
    handled: [
      'Fitness programmes and training info',
      'Membership and facility details',
      'External signup links',
      'Mobile-friendly layout',
    ],
    tags: ['Business Websites'],
  },
  {
    id: 4,
    name: 'Risk & Audit Insights',
    category: 'Blogs & CMS',
    subCategory: 'Professional Publishing',
    url: 'https://riskaai.com/',
    displayUrl: 'riskaai.com',
    oneLiner: 'Professional publishing website powered by Sanity CMS, featuring structured categories and archive.',
    image: '/projects/riskaai.png',
    handled: [
      'Sanity CMS publishing',
      'Content categories',
      'Article archive',
      'Responsive editorial reading experience',
    ],
    tags: ['Blogs & CMS'],
  },
  {
    id: 5,
    name: 'The Emergence Porch',
    category: 'Nonprofit Websites',
    subCategory: 'Youth & Community Organisation',
    url: 'https://theemergenceporch.org/',
    displayUrl: 'theemergenceporch.org',
    oneLiner: 'Nonprofit and community informational website presenting organisational clarity and get-involved paths.',
    image: null,
    handled: [
      'Youth organisation informational website',
      'Purpose and programmes overview',
      'Community get-involved paths',
      'Clean, text-led responsive layout',
    ],
    tags: ['Nonprofit Websites'],
  },
  {
    id: 6,
    name: 'Opeyemi Ogundeji',
    category: 'Portfolios',
    subCategory: 'Personal Professional Portfolio',
    url: 'https://opeyemi-five.vercel.app/',
    displayUrl: 'opeyemi-five.vercel.app',
    oneLiner: 'Personal professional portfolio website showcasing profile focus, initiatives, and contact options.',
    image: '/projects/opeyemi.png',
    handled: [
      'Professional portfolio website',
      'Profile and career focus',
      'Direct contact routes',
      'Responsive design',
    ],
    tags: ['Portfolios'],
  },
];
---

<Layout title="Selected Work — Glickages" description="Explore custom websites crafted by Glickages for businesses, organisations, and professionals.">
  <Header />
  <SocialSidebar />
  <main>
    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="container-custom">
        <div class="animate-on-scroll">
          <p class="text-[var(--accent-cyan)] text-sm font-medium uppercase tracking-widest mb-3">Portfolio</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Selected Work.<br />
            <span class="text-[var(--accent-cyan)]">Built With Purpose.</span>
          </h1>
          <p class="text-[var(--text-muted)] text-base md:text-lg max-w-2xl leading-relaxed">
            A curated selection of custom websites built for businesses and organisations. Every project below is live, responsive, and crafted around real client needs.
          </p>
        </div>
      </div>
    </section>

    <!-- Filter Tabs -->
    <section class="py-6 sticky top-20 z-30 bg-black/90 backdrop-blur-md border-y border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap gap-2.5" id="filter-tabs">
          {filters.map((filter, index) => (
            <button
              data-filter={filter}
              class={`filter-tab px-5 py-2 rounded-full text-xs md:text-sm font-medium transition-all duration-300 ${index === 0 ? 'bg-[var(--accent-cyan)] text-white' : 'bg-white/5 text-[var(--text-muted)] hover:bg-white/10 hover:text-white'}`}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="section-padding">
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
          {projects.map((project) => (
            <div
              class="project-card group rounded-[22px] bg-white/[0.03] border border-white/5 overflow-hidden hover:border-[var(--accent-cyan)]/30 transition-all duration-500 flex flex-col animate-on-scroll"
              data-tags={project.tags.join(',')}
            >
              {project.image ? (
                <div class="aspect-[16/10] overflow-hidden bg-[var(--bg-deep)] relative">
                  <img
                    src={project.image}
                    alt={project.name}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
                </div>
              ) : (
                <div class="aspect-[16/10] bg-gradient-to-br from-[#021833] via-[#042852] to-[#011429] flex flex-col items-center justify-center p-6 text-center border-b border-white/5">
                  <div class="w-14 h-14 rounded-2xl bg-[var(--accent-cyan)]/15 border border-[var(--accent-cyan)]/30 flex items-center justify-center text-[var(--accent-cyan)] mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  </div>
                  <span class="text-white font-semibold text-lg">{project.name}</span>
                  <span class="text-[var(--text-dim)] text-xs mt-1 uppercase tracking-wider">{project.subCategory}</span>
                </div>
              )}

              <div class="p-6 md:p-7 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <span class="px-2.5 py-0.5 rounded-full bg-[var(--accent-cyan)]/10 text-[var(--accent-cyan)] text-xs font-medium">
                      {project.category}
                    </span>
                    <span class="text-white/20">·</span>
                    <span class="text-[var(--text-muted)] text-xs">{project.subCategory}</span>
                  </div>

                  <h3 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--accent-cyan)] transition-colors">
                    {project.name}
                  </h3>

                  <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-4">
                    {project.oneLiner}
                  </p>

                  <div class="mb-5 pt-3 border-t border-white/5">
                    <p class="text-[var(--text-dim)] text-xs uppercase tracking-wider font-semibold mb-2">Key Areas</p>
                    <ul class="space-y-1.5">
                      {project.handled.map(item => (
                        <li class="text-[var(--text-muted)] text-xs flex items-start gap-2">
                          <span class="text-[var(--accent-cyan)] mt-0.5">•</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-xs md:text-sm font-medium text-[var(--accent-cyan)] hover:text-[var(--accent-bright)] transition-colors group/link"
                  >
                    <span>Visit Live Site</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  </a>
                  <span class="text-[var(--text-dim)] text-xs truncate max-w-[130px] hidden sm:inline" title={project.displayUrl}>
                    {project.displayUrl}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="section-padding bg-[var(--bg-dark)]">
      <div class="container-custom">
        <div class="relative rounded-[24px] overflow-hidden bg-gradient-to-br from-[var(--bg-deep)] to-[var(--bg-blue)] p-8 md:p-12 lg:p-16 animate-on-scroll">
          <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--accent-cyan)]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-[var(--accent-cyan)]/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

          <div class="relative z-10 text-center max-w-2xl mx-auto">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
              Need a Website for Your Business?
            </h2>
            <p class="text-[var(--text-muted)] text-base md:text-lg mb-8 leading-relaxed">
              Let's talk about what you want to build. From brand-specific landing pages to full informational sites and content management, we're ready to help.
            </p>
            <a
              href={contactLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--accent-cyan)] text-white rounded-full font-medium hover:bg-[var(--accent-bright)] transition-all duration-300 group"
            >
              Chat on WhatsApp
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </a>
            <p class="mt-4 text-[var(--text-dim)] text-sm">
              Or explore our <a href="/#services" class="text-[var(--accent-cyan)] hover:underline">core services</a>.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const projectCards = document.querySelectorAll<HTMLElement>('#projects-grid .project-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter ?? '';

      tabs.forEach(t => {
        t.classList.remove('bg-[var(--accent-cyan)]', 'text-white');
        t.classList.add('bg-white/5', 'text-[var(--text-muted)]');
      });
      tab.classList.remove('bg-white/5', 'text-[var(--text-muted)]');
      tab.classList.add('bg-[var(--accent-cyan)]', 'text-white');

      projectCards.forEach(card => {
        const tags = (card.dataset.tags || '').split(',');
        if (filter === 'All' || tags.includes(filter)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
