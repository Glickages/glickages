---
import SanityImage from '../../components/blog/SanityImage.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SocialSidebar from '../../components/SocialSidebar.astro';
import Layout from '../../layouts/Layout.astro';
import { getBlogIndexPosts } from '../../lib/sanity/blog';
import { isSanityConfigured } from '../../lib/sanity/config';

const blogs = await getBlogIndexPosts();
const featuredBlogs = blogs.filter((blog) => blog.featured);
const moreBlogs = blogs.filter((blog) => !blog.featured);

function formatPublishedAt(date: string) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
}

function estimateReadTime(excerpt: string) {
  return Math.max(1, Math.ceil(excerpt.split(/\s+/).filter(Boolean).length / 45));
}
---

<Layout title="Blog — Glickages">
  <Header />
  <SocialSidebar />
  <main>
    <section class="relative pb-16 pt-32 lg:pb-20 lg:pt-40">
      <div class="container-custom">
        <div class="animate-on-scroll">
          <p class="mb-3 text-sm font-medium uppercase tracking-widest text-[var(--accent-cyan)]">Our Blogs</p>
          <h1 class="mb-6 text-4xl font-bold text-white md:text-5xl lg:text-6xl">
            Updates From <span class="text-[var(--accent-cyan)]">Insights</span>
          </h1>
          <p class="max-w-2xl text-base leading-relaxed text-[var(--text-muted)] md:text-lg">
            We cover the latest in IT, fintech, software development, and digital marketing — insights to help your business stay ahead.
          </p>
        </div>
      </div>
    </section>

    {
      blogs.length > 0 ? (
        <>
          {featuredBlogs.length > 0 && (
            <section class="section-padding border-t border-white/5">
              <div class="container-custom">
                <div class="mb-10 animate-on-scroll">
                  <h2 class="text-xl font-bold text-white md:text-2xl">Featured Blogs</h2>
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                  {featuredBlogs.map((blog) => (
                    <a
                      href={`/blog/${blog.slug}`}
                      class="group relative overflow-hidden rounded-[20px] border border-white/5 bg-white/[0.03] transition-all duration-500 hover:border-[var(--accent-cyan)]/30 animate-on-scroll"
                    >
                      <div class="aspect-[16/9] overflow-hidden">
                        <SanityImage
                          image={blog.coverImage}
                          alt={blog.coverImage?.alt ?? blog.title}
                          width={1400}
                          sizes="(min-width: 768px) 50vw, 100vw"
                          className="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        />
                      </div>
                      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent"></div>
                      <div class="absolute bottom-0 left-0 right-0 p-6">
                        <div class="mb-3 flex items-center gap-3">
                          <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">
                            {formatPublishedAt(blog.publishedAt)}
                          </span>
                          <span class="text-xs text-white/60">Blog • {estimateReadTime(blog.excerpt)} min read</span>
                        </div>
                        <h3 class="text-lg font-semibold text-white transition-colors group-hover:text-[var(--accent-cyan)]">
                          {blog.title}
                        </h3>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )}

          {moreBlogs.length > 0 && (
            <section class="section-padding bg-[var(--bg-dark)]">
              <div class="container-custom">
                <div class="mb-10 animate-on-scroll">
                  <h2 class="text-xl font-bold text-white md:text-2xl">
                    {featuredBlogs.length > 0 ? 'More Blogs' : 'Latest Blogs'}
                  </h2>
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                  {moreBlogs.map((blog) => (
                    <a
                      href={`/blog/${blog.slug}`}
                      class="group overflow-hidden rounded-[20px] border border-white/5 bg-white/[0.03] transition-all duration-500 hover:border-[var(--accent-cyan)]/30 animate-on-scroll"
                    >
                      <div class="aspect-[16/9] overflow-hidden">
                        <SanityImage
                          image={blog.coverImage}
                          alt={blog.coverImage?.alt ?? blog.title}
                          width={900}
                          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                          className="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                        />
                      </div>
                      <div class="p-6">
                        <div class="mb-3 flex items-center gap-3">
                          <span class="text-xs font-medium text-[var(--accent-cyan)]">{formatPublishedAt(blog.publishedAt)}</span>
                          <span class="text-xs text-[var(--text-dim)]">• {estimateReadTime(blog.excerpt)} min read</span>
                        </div>
                        <h3 class="mb-2 text-base font-semibold text-white transition-colors group-hover:text-[var(--accent-cyan)]">
                          {blog.title}
                        </h3>
                        <p class="text-sm text-[var(--text-muted)]">{blog.excerpt}</p>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )}
        </>
      ) : (
        <section class="section-padding border-t border-white/5">
          <div class="container-custom">
            <div class="mx-auto max-w-3xl overflow-hidden rounded-[28px] border border-white/8 bg-[radial-gradient(circle_at_top,rgba(68,200,245,0.18),transparent_42%),linear-gradient(135deg,rgba(3,32,67,0.95),rgba(15,15,15,0.98))] p-8 text-center md:p-12 animate-on-scroll">
              <p class="mb-3 text-sm font-medium uppercase tracking-[0.25em] text-[var(--accent-bright)]">Insights Coming Soon</p>
              <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">
                The blog is now powered by our CMS and ready for fresh stories.
              </h2>
              <p class="mx-auto max-w-2xl text-base leading-relaxed text-[var(--text-muted)] md:text-lg">
                {isSanityConfigured
                  ? 'We are preparing the first wave of articles. Check back soon for practical notes on product strategy, engineering, and growth.'
                  : 'The editorial pipeline is in place. Add your Sanity project credentials and publish your first post to bring this space to life.'}
              </p>
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
