---
---

<section id="about" class="section-padding">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image side -->
      <div class="relative animate-on-scroll">
        <div class="relative rounded-[20px] overflow-hidden">
          <img 
            src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80" 
            alt="Team working together" 
            class="w-full h-[400px] lg:h-[500px] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        </div>
        
        <!-- Floating stat cards -->
        <div class="absolute -bottom-6 right-4 lg:-right-4 bg-white rounded-[16px] p-4 shadow-2xl animate-on-scroll delay-200">
          <p class="text-[var(--accent-cyan)] text-2xl font-bold">10+</p>
          <p class="text-[var(--bg-dark)] text-xs font-medium uppercase tracking-wide">Projects Shipped</p>
        </div>
        <div class="absolute -top-4 left-4 lg:-left-4 bg-white rounded-[16px] p-4 shadow-2xl animate-on-scroll delay-300">
          <p class="text-[var(--accent-cyan)] text-2xl font-bold">8+</p>
          <p class="text-[var(--bg-dark)] text-xs font-medium uppercase tracking-wide">Happy Clients</p>
        </div>
      </div>

      <!-- Text side -->
      <div class="animate-on-scroll delay-100">
        <p class="text-[var(--accent-cyan)] text-sm font-medium uppercase tracking-widest mb-3">About Us</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          We're <span class="text-[var(--accent-cyan)]">Builders.</span><br />
          Not Just Vendors.
        </h2>
        <div class="border-l-2 border-[var(--accent-cyan)] pl-6 mb-6">
          <p class="text-[var(--text-muted)] leading-relaxed mb-4">
            At Glickages, we believe every business — regardless of size — deserves software that works as hard as they do. We're a focused team of developers and designers who genuinely care about the work we put out.
          </p>
          <p class="text-[var(--text-muted)] leading-relaxed">
            We take on projects where we can make a real difference, and we treat every client's business like it matters — because it does. We've worked with startups, SMEs, and growing brands across Nigeria and beyond. If you're ready to build something great, we're ready to build it with you.
          </p>
        </div>
        <a 
          href="/work" 
          class="inline-flex items-center gap-2 text-[var(--accent-cyan)] font-medium hover:text-[var(--accent-bright)] transition-colors group"
        >
          See Our Work
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
