---
const steps = [
  {
    number: '01',
    title: 'We Listen First',
    description: 'You tell us about your business, your goals, and your timeline. No assumptions, no premade templates — just a real conversation about what you actually need.',
  },
  {
    number: '02',
    title: 'We Plan It Out',
    description: 'We map out the solution, agree on scope and timeline, and make sure you understand exactly what you\'re getting before we write a single line of code.',
  },
  {
    number: '03',
    title: 'We Build',
    description: 'We get straight to work. You get regular updates, and we stay available for feedback throughout. Your input shapes the final product.',
  },
  {
    number: '04',
    title: 'We Launch & Stay Around',
    description: 'We ship when you\'re happy — not before. And when you go live, we don\'t disappear. We\'re here for what comes next too.',
  },
];
---

<section class="section-padding bg-[var(--bg-dark)]">
  <div class="container-custom">
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <p class="text-[var(--accent-cyan)] text-sm font-medium uppercase tracking-widest mb-3">Process</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white">
        Simple Process. <span class="text-[var(--accent-cyan)]">No Surprises.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {steps.map((step, index) => (
        <div class={`relative animate-on-scroll delay-${(index + 1) * 100}`}>
          <div class="mb-4">
            <span class="text-5xl font-bold text-[var(--accent-cyan)]/20">{step.number}</span>
          </div>
          <h3 class="text-white font-semibold text-lg mb-3">{step.title}</h3>
          <p class="text-[var(--text-muted)] text-sm leading-relaxed">{step.description}</p>

          {index < steps.length - 1 && (
            <div class="hidden lg:block absolute top-8 -right-4 w-8 h-px bg-gradient-to-r from-[var(--accent-cyan)]/50 to-transparent"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
