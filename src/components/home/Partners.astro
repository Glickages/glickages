---
const partners = [
  'FendAm Academy',
  'Cyberdicts',
  'Which AI Tool',
  'ICC Studios',
  'iSalesBook',
  'The Emergence Porch',
  'Risk and Audit Insights',
  'Cataleex',
];
---

<section class="py-16 lg:py-20 border-t border-white/5">
  <div class="container-custom">
    <div class="text-center mb-10 animate-on-scroll">
      <h2 class="text-2xl md:text-3xl font-bold text-white">
        Our <span class="text-[var(--accent-cyan)]">Clients</span>
      </h2>
      <p class="text-[var(--text-muted)] text-sm mt-2">Our clients are everything to us; so are we to them.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 animate-on-scroll delay-100">
      {partners.map(partner => (
        <div class="flex items-center justify-center p-6 rounded-[12px] bg-white/[0.02] border border-white/5 hover:border-white/10 transition-colors">
          <span class="text-[var(--text-muted)] text-sm font-medium text-center">{partner}</span>
        </div>
      ))}
    </div>
  </div>
</section>
