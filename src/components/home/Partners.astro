---
const clientProjects = [
  { name: 'Love Fest Foundation', url: 'https://lff-website.lovefestfoundation.workers.dev/' },
  { name: 'ICC Studios', url: 'https://icc-delta.vercel.app/' },
  { name: 'Warrior Fitness', url: 'https://warrior-fitness-xi.vercel.app/' },
  { name: 'Risk & Audit Insights', url: 'https://riskaai.com/' },
  { name: 'The Emergence Porch', url: 'https://theemergenceporch.org/' },
  { name: 'Opeyemi Ogundeji', url: 'https://opeyemi-five.vercel.app/' },
];
---

<section class="py-16 lg:py-20 border-t border-white/5">
  <div class="container-custom">
    <div class="text-center mb-10 animate-on-scroll">
      <h2 class="text-2xl md:text-3xl font-bold text-white">
        Selected <span class="text-[var(--accent-cyan)]">Client Projects</span>
      </h2>
      <p class="text-[var(--text-muted)] text-sm mt-2">Websites designed and delivered for businesses and organisations.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 animate-on-scroll delay-100">
      {clientProjects.map(project => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center p-5 rounded-[12px] bg-white/[0.02] border border-white/5 hover:border-[var(--accent-cyan)]/40 hover:bg-white/[0.05] transition-all text-center group"
        >
          <span class="text-[var(--text-muted)] group-hover:text-white text-xs font-medium transition-colors">{project.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
