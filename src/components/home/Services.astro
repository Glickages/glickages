---
const services = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
    title: 'Custom Website Development',
    description: 'Custom websites designed and developed specifically for your business or organisation. No generic templates — just clean code, tailored layouts, and an online presence that reflects your brand.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>',
    title: 'Landing Pages & Informational Sites',
    description: 'Clear, concise websites that tell your story and present your services or cause effectively. Structured navigation and clear calls-to-action that guide visitors to connect with you.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>',
    title: 'Blogs & Content Management',
    description: 'Editorial platforms and an easy-to-use content editor that give your team the autonomy to publish updates, articles, and announcements without touching code.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>',
    title: 'Responsive & Accessible Design',
    description: 'Every layout is tested across devices and screen sizes to ensure fast load times, readable typography, and effortless browsing whether your visitors are on mobile or desktop.',
  },
];
---

<section id="services" class="section-padding">
  <div class="container-custom">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between mb-12 lg:mb-16">
      <div class="animate-on-scroll">
        <p class="text-[var(--accent-cyan)] text-sm font-medium uppercase tracking-widest mb-3">Services</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white">
          Custom websites.<br />
          <span class="text-[var(--accent-cyan)]">Built around your business.</span>
        </h2>
      </div>
      <p class="text-[var(--text-muted)] text-sm mt-4 lg:mt-0 max-w-md animate-on-scroll delay-100">
        Custom website development for businesses and organisations, with optional blog and content management.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service, index) => (
        <div class={`group relative p-6 lg:p-8 rounded-[20px] bg-white/[0.03] border border-white/5 hover:border-[var(--accent-cyan)]/30 transition-all duration-500 animate-on-scroll delay-${(index + 1) * 100}`}>
          <div class="w-12 h-12 rounded-xl bg-[var(--accent-cyan)]/10 flex items-center justify-center text-[var(--accent-cyan)] mb-5 group-hover:bg-[var(--accent-cyan)] group-hover:text-white transition-all duration-300">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-white font-semibold text-lg mb-3">{service.title}</h3>
          <p class="text-[var(--text-muted)] text-sm leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
