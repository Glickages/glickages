---
const services = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
    title: 'Custom Web Development',
    description: 'From lightning-fast landing pages to complex web applications — we build sites and platforms that look sharp, load fast, and turn visitors into customers. No cookie-cutter templates. Every line written with your business in mind.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>',
    title: 'Full-Stack Apps & SaaS Products',
    description: 'Have an idea for a product? We take it from concept to market-ready. Whether it\'s an MVP to test the waters or a fully custom SaaS platform, we handle the full stack — frontend, backend, database, and everything in between.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>',
    title: 'E-Commerce Development',
    description: 'Sell online the right way. We build storefronts that are easy to manage, secure to run, and designed to drive sales — not just look pretty. Your customers should find it easy to buy from you. We make sure they do.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 5-5v0a5 5 0 0 0-5-5z"></path></svg>',
    title: 'Cloud & VPS Management',
    description: 'Your product shouldn\'t go down at 2 AM. We set up, optimize, and manage your cloud or VPS infrastructure so your platform stays fast, stable, and secure — around the clock.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
    title: 'SEO & Online Visibility',
    description: 'Being online isn\'t enough — you need to be found. We help your business show up where your customers are already searching and build the kind of online presence that keeps working long after we\'re done.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"></path></svg>',
    title: 'AI Integrations',
    description: 'Add intelligence to your product. From smart search and chatbots to automated workflows and AI-powered features — we bring modern AI capabilities into your existing platforms or weave them into something new.',
  },
];
---

<section id="services" class="section-padding">
  <div class="container-custom">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between mb-12 lg:mb-16">
      <div class="animate-on-scroll">
        <p class="text-[var(--accent-cyan)] text-sm font-medium uppercase tracking-widest mb-3">Services</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white">
          Everything Your Business Needs<br />
          to <span class="text-[var(--accent-cyan)]">Win Online.</span>
        </h2>
      </div>
      <p class="text-[var(--text-muted)] text-sm mt-4 lg:mt-0 max-w-md animate-on-scroll delay-100">
        We cover the full stack — from your first webpage to your next big product.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, index) => (
        <div class={`group relative p-6 lg:p-8 rounded-[20px] bg-white/[0.03] border border-white/5 hover:border-[var(--accent-cyan)]/30 transition-all duration-500 animate-on-scroll delay-${(index + 1) * 100}`}>
          <div class="w-12 h-12 rounded-xl bg-[var(--accent-cyan)]/10 flex items-center justify-center text-[var(--accent-cyan)] mb-5 group-hover:bg-[var(--accent-cyan)] group-hover:text-white transition-all duration-300">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-white font-semibold text-lg mb-3">{service.title}</h3>
          <p class="text-[var(--text-muted)] text-sm leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
