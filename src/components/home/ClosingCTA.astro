---
import { contactLinks } from '../../lib/site';
---

<section id="contact" class="section-padding">
  <div class="container-custom">
    <div class="relative rounded-[24px] overflow-hidden bg-gradient-to-br from-[var(--bg-deep)] to-[var(--bg-blue)] p-8 md:p-12 lg:p-16 animate-on-scroll">
      <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--accent-cyan)]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-[var(--accent-cyan)]/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

      <div class="relative z-10 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
          Got a project in mind?
        </h2>
        <p class="text-[var(--text-muted)] text-base md:text-lg mb-8 leading-relaxed">
          Whether you need a new website, a tailored landing page, or a content-managed platform — let's have a conversation about what you need.
        </p>
        <a
          href={contactLinks.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--accent-cyan)] text-white rounded-full font-medium hover:bg-[var(--accent-bright)] transition-all duration-300 group"
        >
          Chat on WhatsApp
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
