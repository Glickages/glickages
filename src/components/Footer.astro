---
import { contactLinks, siteConfig } from "../lib/site";

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "About us", href: "/#about" },
  { label: "Services", href: "/#services" },
  { label: "Work", href: "/work" },
  { label: "Blog", href: "/blog" },
  { label: "Contact us", href: "/#contact" },
  { label: "Privacy Policy", href: "#" },
  { label: "Terms & Conditions", href: "#" },
];
---

<footer class="bg-[var(--bg-dark)] border-t border-white/5">
  <div class="container-custom py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand & Newsletter -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-6">
          <img src="/logo.png" alt={siteConfig.siteName} class="h-8 w-auto" />
          <span class="text-white font-semibold text-lg tracking-wide"
            >{siteConfig.siteName}</span
          >
        </a>
        <p class="text-[var(--text-muted)] text-sm mb-6">
          Distinctive custom websites for businesses and organisations.
        </p>
        <div class="mb-4">
          <p class="text-white text-sm font-medium mb-3">
            Subscribe to our Newsletter
          </p>
          <form class="flex items-center gap-2 border-b border-white/20 pb-2">
            <input
              type="email"
              placeholder="Your email"
              class="bg-transparent text-white text-sm placeholder:text-[var(--text-dim)] outline-none flex-1"
            />
            <button
              type="submit"
              aria-label="Subscribe"
              class="text-[var(--accent-cyan)] hover:text-[var(--accent-bright)] transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
                  points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
              >
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Access -->
      <div>
        <h4 class="text-white font-semibold mb-6 relative inline-block">
          Quick Access
          <span
            class="absolute -bottom-1 left-0 w-8 h-0.5 bg-[var(--accent-cyan)]"
          ></span>
        </h4>
        <ul class="space-y-3">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[var(--text-muted)] text-sm hover:text-[var(--accent-cyan)] transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-6 relative inline-block">
          Contact
          <span
            class="absolute -bottom-1 left-0 w-8 h-0.5 bg-[var(--accent-cyan)]"
          ></span>
        </h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="text-[var(--accent-cyan)] mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
            </span>
            <div>
              <p class="text-[var(--text-dim)] text-xs mb-0.5">Call now</p>
              <a
                href={contactLinks.phone}
                class="text-white text-sm hover:text-[var(--accent-cyan)] transition-colors"
                >{siteConfig.phoneDisplay}</a
              >
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[var(--accent-cyan)] mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                ></path></svg
              >
            </span>
            <div>
              <p class="text-[var(--text-dim)] text-xs mb-0.5">WhatsApp</p>
              <a
                href={contactLinks.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white text-sm hover:text-[var(--accent-cyan)] transition-colors"
                >{siteConfig.phoneDisplay}</a
              >
            </div>
          </li>
        </ul>
      </div>

      <!-- Socials -->
      <div>
        <h4 class="text-white font-semibold mb-6 relative inline-block">
          Follow Us
          <span
            class="absolute -bottom-1 left-0 w-8 h-0.5 bg-[var(--accent-cyan)]"
          ></span>
        </h4>
        <div class="flex gap-4">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={siteConfig.socialLinks.linkedin}
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={siteConfig.socialLinks.X}
            aria-label="X"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)] transition-all duration-300"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 120 120"
              xmlns="http://www.w3.org/2000/svg"
              aria-label="X-style placeholder"
            >
              <path d="M28 25H43L94 95H79L28 25Z" fill="#fff"></path>
              <path d="M80 25H94L41 95H27L80 25Z" fill="#fff"></path>
              <path d="M33 29H40L88 91H81L33 29Z" fill="#000" opacity="0.18"
              ></path>
            </svg>
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={siteConfig.socialLinks.facebook}
            aria-label="Facebook"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={siteConfig.socialLinks.instagram}
            aria-label="Instagram"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
              ></path></svg
            >
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={siteConfig.socialLinks.whatsapp}
            aria-label="WhatsApp"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:border-[var(--accent-cyan)] hover:text-[var(--accent-cyan)] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="text-[var(--text-dim)] text-xs">
        Glickages &copy; 2026 All rights reserved
      </p>
      <a
        href="#"
        id="back-to-top"
        class="text-[var(--text-dim)] text-xs hover:text-[var(--accent-cyan)] transition-colors flex items-center gap-2"
      >
        BACK TO TOP
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M18 15l-6-6-6 6"></path></svg
        >
      </a>
    </div>
  </div>
</footer>

<script>
  document.getElementById("back-to-top")?.addEventListener("click", (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
